---
import "../styles/global.css";
import DemoLayout from "./DemoLayout.astro";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Strategic advice for confident business decisions.",
} = Astro.props;

// Ensure BASE_URL ends with / so we can just append relative paths
// Ensure BASE_URL ends with / so we can just append relative paths
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";

const navItems = [
    { name: "Home", href: "" },
    { name: "Services", href: "services" },
    { name: "About", href: "about" },
    { name: "Contact", href: "contact" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <meta name="robots" content="noindex, nofollow" />
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

        <!-- Canonical -->
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

        <!-- Open Graph / Twitter -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={`${base}og-image.png`} />
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={`${base}og-image.png`} />

        <!-- Non-indexed portfolio demo: intentionally no schema -->

        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body
        class="bg-surface text-text-main flex flex-col min-h-screen font-sans antialiased"
    >
        <DemoLayout>
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 bg-primary text-white px-4 py-2 rounded font-medium shadow-lg"
        >
            Skip to content
        </a>

        <header
            class="border-b border-border-subtle bg-surface/90 backdrop-blur sticky top-0 z-40"
        >
            <div
                class="container-custom h-20 flex items-center justify-between"
            >
                <a
                    href={base}
                    class="font-heading font-bold text-xl tracking-tight"
                >
                    Modern<span class="text-primary">Consultant</span>
                </a>

                <nav class="hidden md:flex gap-8">
                    {
                        navItems.map((item) => (
                            <a
                                href={`${base}${item.href}`}
                                class="text-text-muted hover:text-primary transition-colors font-medium text-sm"
                            >
                                {item.name}
                            </a>
                        ))
                    }
                </nav>

                <div class="hidden md:block">
                    <a
                        href={`${base}contact`}
                        class="bg-primary text-white px-5 py-2.5 rounded text-sm font-semibold hover:opacity-90 transition-opacity shadow-sm"
                    >
                        Book Consultation
                    </a>
                </div>

                <!-- Mobile Menu Toggle -->
                <button
                    id="menu-toggle"
                    class="md:hidden text-text-main p-2"
                    aria-label="Menu"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-6 h-6"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                        ></path>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Mobile Navigation Overlay -->
        <div
            id="mobile-menu"
            class="fixed inset-0 bg-surface z-50 hidden flex-col pt-24 px-6 md:hidden transition-opacity duration-200"
        >
            <button
                id="menu-close"
                class="absolute top-6 right-4 sm:right-6 p-2 text-text-main"
                aria-label="Close Menu"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-8 h-8"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
            <nav class="flex flex-col gap-6 text-xl font-heading font-medium">
                {
                    navItems.map((item) => (
                        <a
                            href={`${base}${item.href}`}
                            class="hover:text-primary transition-colors block py-2 border-b border-border-subtle/50 pb-4"
                        >
                            {item.name}
                        </a>
                    ))
                }
                <a
                    href={`${base}contact`}
                    class="bg-primary text-white px-5 py-3 rounded text-center mt-4 font-semibold shadow-md"
                    >Book Consultation</a
                >
            </nav>
        </div>

        <script>
            const menuToggle = document.getElementById("menu-toggle");
            const menuClose = document.getElementById("menu-close");
            const mobileMenu = document.getElementById("mobile-menu");

            if (menuToggle && menuClose && mobileMenu) {
                menuToggle.addEventListener("click", () => {
                    mobileMenu.classList.remove("hidden");
                    mobileMenu.classList.add("flex");
                    document.body.style.overflow = "hidden";
                });

                menuClose.addEventListener("click", () => {
                    mobileMenu.classList.add("hidden");
                    mobileMenu.classList.remove("flex");
                    document.body.style.overflow = "";
                });
            }
        </script>

        <main id="main-content" class="flex-grow">
            <slot />
        </main>

        <footer class="bg-surface border-t border-border-subtle py-16 mt-20">
            <div class="container-custom grid md:grid-cols-4 gap-12">
                <div class="col-span-1 md:col-span-2">
                    <a
                        href={base}
                        class="font-heading font-bold text-lg block mb-6"
                        >Modern<span class="text-primary">Consultant</span></a
                    >
                    <p class="text-text-muted text-sm max-w-xs leading-relaxed">
                        Helping growing businesses navigate growth, compliance,
                        and complexity with clarity and confidence.
                    </p>
                </div>

                <div>
                    <h4 class="font-heading font-bold mb-6 text-sm">
                        Services
                    </h4>
                    <ul class="space-y-3 text-sm text-text-muted">
                        <li>
                            <a
                                href={`${base}services`}
                                class="hover:text-primary transition-colors"
                                >Business Advisory</a
                            >
                        </li>
                        <li>
                            <a
                                href={`${base}services`}
                                class="hover:text-primary transition-colors"
                                >Financial Planning</a
                            >
                        </li>
                        <li>
                            <a
                                href={`${base}services`}
                                class="hover:text-primary transition-colors"
                                >Compliance & Risk</a
                            >
                        </li>
                        <li>
                            <a
                                href={`${base}services`}
                                class="hover:text-primary transition-colors"
                                >Strategic Growth</a
                            >
                        </li>
                    </ul>
                </div>

                <div>
                    <h4 class="font-heading font-bold mb-6 text-sm">Contact</h4>
                    <ul class="space-y-3 text-sm text-text-muted">
                        <li class="flex items-start gap-2">
                            <span>Non-indexed portfolio concept demo</span>
                        </li>
                        <li>
                            <a
                                href="https://amplifycreativelab.com"
                                target="_blank"
                                rel="nofollow noopener noreferrer"
                                class="hover:text-primary transition-colors"
                                >amplifycreativelab.com</a
                            >
                        </li>
                    </ul>
                </div>
            </div>
            <div
                class="container-custom mt-16 pt-8 border-t border-border-subtle text-xs text-text-muted flex flex-col md:flex-row justify-between items-center gap-4"
            >
                <p>
                    &copy; {new Date().getFullYear()} Modern Consultant. All rights
                    reserved.
                </p>
                <div class="flex gap-6">
                    <a
                        href={`${base}privacy`}
                        class="hover:text-primary transition-colors"
                        >Privacy Policy</a
                    >
                    <a href="#" class="hover:text-primary transition-colors"
                        >Terms of Service</a
                    >
                </div>
            </div>
        </footer>
        </DemoLayout>
    </body>
</html>

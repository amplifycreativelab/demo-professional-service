---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import Testimonial from "../components/Testimonial.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";

const stats = [
    { label: "Years Experience", value: "15+" },
    { label: "Industries Served", value: "12" },
    { label: "Growth Generated", value: "$100M+" },
    { label: "Client Retention", value: "94%" },
];
---

<BaseLayout
    title="About Us | Modern Consultant"
    description="We are a Perth-based strategic advisory firm dedicated to helping businesses navigate complexity with precision."
>
    <section class="py-24 md:py-32 bg-surface border-b border-border-subtle">
        <div class="container-custom grid md:grid-cols-2 gap-16 items-start">
            <div>
                <h1
                    class="font-heading font-bold text-5xl md:text-6xl text-text-main mb-8 leading-tight"
                >
                    Precision in an uncertain world.
                </h1>
                <div class="w-20 h-1 bg-primary mb-8"></div>
            </div>
            <div class="space-y-6 text-lg text-text-muted leading-relaxed">
                <p>
                    We founded Modern Consultant on a simple premise: complexity
                    should be managed, not feared. In today's volatile economic
                    landscape, instinct is no longer enough. Business leaders
                    need data, rigorous analysis, and strategic clarity.
                </p>
                <p>
                    Based in Perth, Western Australia, we partner with ambitious
                    SMEs and established firms to unlock value that is often
                    hidden in plain sight. We are not generalists; we are
                    specialists in growth, risk, and financial architecture.
                </p>
                <p>
                    Our philosophy is quiet confidence. We believe that true
                    expertise doesn't need to shout. It shows up in the details,
                    in the silence of a well-solved problem, and in the bottom
                    line.
                </p>
            </div>
        </div>
    </section>

    <!-- Stats -->
    <section class="py-16 border-b border-border-subtle bg-white">
        <div class="container-custom grid grid-cols-2 md:grid-cols-4 gap-8">
            {
                stats.map((stat) => (
                    <div class="text-center md:text-left">
                        <div class="font-heading font-bold text-4xl text-primary mb-2">
                            {stat.value}
                        </div>
                        <div class="text-sm text-text-muted font-medium tracking-wide uppercase">
                            {stat.label}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Team/Approach Section -->
    <section class="py-24 bg-surface">
        <div class="container-custom grid md:grid-cols-12 gap-12">
            <div class="md:col-span-5">
                <h2 class="font-heading font-bold text-3xl text-text-main mb-6">
                    Our Approach
                </h2>
                <p class="text-text-muted mb-6">
                    We work as an extension of your leadership team. We don't
                    just hand over a report and walk away. We stand beside you
                    during implementation, accounting for the execution risk
                    that often derails the best strategies.
                </p>
                <ul class="space-y-4 text-text-main font-medium">
                    <li class="flex items-center gap-3">
                        <span class="text-primary">&rarr;</span> Evidence-based methodology
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="text-primary">&rarr;</span> Candid, unfiltered
                        advice
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="text-primary">&rarr;</span> Long-term partnership
                        focus
                    </li>
                </ul>
            </div>
            <div class="md:col-span-7 grid gap-6 sm:grid-cols-2">
                <div class="bg-white p-6 border border-border-subtle">
                    <h3 class="font-heading font-bold text-lg mb-2">
                        Discovery
                    </h3>
                    <p class="text-sm text-text-muted">
                        Deep dive into your financials, operations, and market
                        position to establish a baseline of truth.
                    </p>
                </div>
                <div class="bg-white p-6 border border-border-subtle">
                    <h3 class="font-heading font-bold text-lg mb-2">
                        Diagnosis
                    </h3>
                    <p class="text-sm text-text-muted">
                        Identifying the root causes of friction and the
                        highest-leverage opportunities for growth.
                    </p>
                </div>
                <div class="bg-white p-6 border border-border-subtle">
                    <h3 class="font-heading font-bold text-lg mb-2">Design</h3>
                    <p class="text-sm text-text-muted">
                        Crafting a bespoke strategy that aligns with your
                        resources, risk appetite, and vision.
                    </p>
                </div>
                <div class="bg-white p-6 border border-border-subtle">
                    <h3 class="font-heading font-bold text-lg mb-2">
                        Deployment
                    </h3>
                    <p class="text-sm text-text-muted">
                        Systematic execution with regular feedback loops to
                        adaptation to changing conditions.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <CTASection
        headline="Let's build a stronger future."
        btnText="Book a Consultation"
        href={`${base}contact`}
    />
</BaseLayout>

---
interface Props {
    client: string;
    problem: string;
    outcome: string;
    href: string;
}
const { client, problem, outcome, href } = Astro.props;
---

<a
    href={href}
    class="block p-8 bg-surface border-t border-border-subtle hover:bg-white hover:border-primary transition-all group h-full"
>
    <div class="text-xs font-bold text-primary uppercase tracking-wider mb-2">
        {client}
    </div>
    <h3
        class="font-heading font-bold text-xl mb-4 text-text-main group-hover:text-primary transition-colors"
    >
        {problem}
    </h3>
    <div
        class="mt-4 pt-4 border-t border-border-subtle/50 text-text-muted text-sm"
    >
        <strong class="text-text-main">Outcome:</strong>
        {outcome}
    </div>
    <span
        class="inline-block mt-6 text-sm font-semibold text-text-main underline decoration-border-subtle underline-offset-4 group-hover:decoration-primary transition-all"
    >
        View Case Study
    </span>
</a>

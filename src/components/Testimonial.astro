---
interface Props {
    quote: string;
    author: string;
    role: string;
}

const { quote, author, role } = Astro.props;
---

<blockquote
    class="p-8 bg-surface border-l-4 border-primary h-full flex flex-col justify-between"
>
    <p
        class="text-xl md:text-2xl font-heading font-medium text-text-main mb-6 leading-relaxed"
    >
        "{quote}"
    </p>
    <footer class="text-sm">
        <cite class="not-italic font-bold text-text-main block">{author}</cite>
        <span class="text-text-muted">{role}</span>
    </footer>
</blockquote>
